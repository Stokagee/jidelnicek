# Copy to .env and fill in real values. Do NOT commit .env.

# --- Postgres ---
POSTGRES_DB=jidelnicek
POSTGRES_USER=jidelnicek
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://jidelnicek:change-me-strong-password@db:5432/jidelnicek
# Dedicated, disposable database for the pytest suite (host-side, never the dev DB).
# If unset, it is derived from DATABASE_URL (host db→localhost, name +"_test").
TEST_DATABASE_URL=postgresql+psycopg://jidelnicek:change-me-strong-password@127.0.0.1:5432/jidelnicek_test

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
# Session cookie signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-random-48-bytes

# --- Web ---
WEB_PORT=5173
# The web app reaches the API same-origin via the Vite dev-server proxy (no CORS
# needed), so this is normally left unset. Only set an absolute URL if the web app
# must call an API on a different origin — and configure that origin's CORS too.
# VITE_API_BASE_URL=

# --- Admin seed (used by `uv run seed` on first run) ---
# These create the single is_cook=true user. The other 3 members are seeded
# unclaimed and receive claim tokens printed to stdout by the seed script.
ADMIN_NAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password

# Usernames for the 3 seeded members (unclaimed, receive claim tokens printed to stdout by the seed script).
# Has ID=2 in the seed script.
USER2_NAME=Kateřina
USER2_PASSWORD=katka123

# Has ID=3 in the seed script.
USER3_NAME=Matěj
USER3_PASSWORD=matej123

# Has ID=4 in the seed script.
USER4_NAME=Mia
USER4_PASSWORD=mia123

# --- Notifications (worker) ---
# Discord webhook URL for the cook's alerts and 6h digest (FR-N5).
DISCORD_WEBHOOK_URL=
# Digest cadence in hours (FR-N3 = 6).
DIGEST_INTERVAL_HOURS=6

# --- Timezone ---
# BR-9: all date math is Europe/Prague.
TZ=Europe/Prague

# --- Observability ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
# Read-only Postgres role for Grafana's business datasource (FR-O3). Created by
# infra/postgres/initdb on a fresh DB volume; never the app/admin user.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=change-me-grafana-readonly
# Optional overrides (default to the app DB on the compose network):
# GRAFANA_DB_HOST=db
# GRAFANA_DB_PORT=5432
# GRAFANA_DB_NAME=jidelnicek
